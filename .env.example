# Provider: "groq" (default, cheap) or "openai"
TRANSCRIPTION_PROVIDER=groq

# Groq: $0.03/hour (whisper-large-v3)
# Free key is tried first; if rate-limited, falls back to paid key
GROQ_API_KEY=gsk-your-free-key-here
GROQ_API_KEY_PAID=gsk-your-paid-key-here

# OpenAI: $0.36/hour (whisper-1), also used by `parse` and `summary` commands
# summary command uses gpt-5.1 for analysis; web search uses DuckDuckGo (no extra key needed)
OPENAI_API_KEY=sk-your-key-here

# Gmail SMTP: for sending daily summary reports
# Setup: Google Account → 开启 2-Step Verification → 生成 App Password
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=your-email@gmail.com
